# ============================================================
#  拾光 · 环境变量示例
#  复制成 .env.local（前端）和 backend/.env（后端）后按需填写
#  .env / .env.local / backend/.env 都已被 .gitignore 忽略，不会进仓库
# ============================================================

# ---------- 站点 ----------
NEXT_PUBLIC_SITE_TITLE=拾光 · AI 数字记忆与人生故事馆
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_AUTHOR=YourName

# ---------- 站点访问密码（演示级保护，不是真实鉴权） ----------
NEXT_PUBLIC_SITE_AUTH_ENABLED=true
NEXT_PUBLIC_SITE_AUTH_USER=admin
NEXT_PUBLIC_SITE_AUTH_PASS=change-me
NEXT_PUBLIC_SITE_AUTH_TOKEN=dev-auth-token

# ---------- 社交链接 ----------
NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/yourname
NEXT_PUBLIC_SOCIAL_GITEE=
NEXT_PUBLIC_SOCIAL_EMAIL=you@example.com

# ---------- 备案（不需要就留空） ----------
NEXT_PUBLIC_ICP_NAME=
NEXT_PUBLIC_MOE_ICP_NAME=

# ---------- 后端接口 ----------
# 前端请求 /api/* 由 next.config.ts 的 rewrites 转发到这里
BACKEND_URL=http://127.0.0.1:8000
# 小说阅读服务（可选）
NOVEL_API_URL=http://127.0.0.1:8085

# ---------- 数据库（backend/.env） ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=shiguang

# ---------- 语音合成（backend/.env，edge-tts，免费） ----------
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=-8%
TTS_VOLUME=+0%

# ---------- DeepSeek（backend/.env，可选） ----------
# 申请地址 https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---------- 音乐平台账号 Cookie（可选，仅服务端使用） ----------
# 填了可以拿会员音质 / 完整音源；不填按未登录处理（VIP 歌曲只有试听片段）
# 获取方式：浏览器登录 music.163.com → F12 → Network → 任意请求 → 复制请求头里的 Cookie 整行
# 格式示例：NETEASE_COOKIE=MUSIC_U=xxxxx; __csrf=yyyyy
# ⚠️ 这等同于账号钥匙，绝对不要提交到仓库
# NETEASE_COOKIE=
# TENCENT_COOKIE=
# KUGOU_COOKIE=
