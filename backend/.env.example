# 数据库连接（填上你的 MySQL 密码即可）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=shiguang

# 配音音色（edge-tts，免费）
# 常用中文音色：
#   zh-CN-XiaoxiaoNeural   晓晓 · 女声 · 温柔自然（默认）
#   zh-CN-XiaoyiNeural     晓伊 · 女声 · 年轻
#   zh-CN-YunxiNeural      云希 · 男声 · 沉稳
#   zh-CN-YunjianNeural    云健 · 男声 · 有力
#   zh-CN-liaoning-XiaobeiNeural  东北话女声（彩蛋）
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=-8%
TTS_VOLUME=+0%

# DeepSeek（可选）：填上 Key 后，上传的「分析」会用真实大模型生成标题/摘要/标签
# 申请地址 https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
